# Copy to .env for docker compose, or export before `docker compose up`.
ASTRO_ALLOW_PAID=0
ASTRO_PROGRESSIVE_READING=0
ASTRO_GUEST_ONBOARDING=0
ASTRO_ASK_ENABLED=0

# Demo mode (default): any email + code 000000 creates an isolated account.
AUTH_ENABLED=0

# Multi-user Supabase (omit AUTH_OWNER_EMAIL so every confirmed user is a tenant):
# AUTH_ENABLED=1
# SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# AUTH_OWNER_EMAIL=

# Optional paid LLM keys
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Copy to .env for docker compose, or export before `docker compose up`.
# Full stack: docker compose up --build
# Dev (Postgres only + host API): docker compose -f docker-compose.dev.yml up -d
#   then export DATABASE_URL=postgres://astrology:astrology@127.0.0.1:5432/astrology
#
# Production compose REQUIRES POSTGRES_PASSWORD (no default). Prefer URL-safe
# characters, or URL-encode special characters in the password.
POSTGRES_USER=astrology
POSTGRES_PASSWORD=replace-with-a-strong-secret
POSTGRES_DB=astrology

ASTRO_ALLOW_PAID=0
ASTRO_PROGRESSIVE_READING=0
ASTRO_GUEST_ONBOARDING=1
ASTRO_ASK_ENABLED=0

# Global HTTP rate limits (in-process, memory only — reset on restart).
# See docs/RATE_LIMIT.md.
# Coolify/Traefik: ASTRO_TRUST_PROXY_HOPS=1. Cloudflare in front of Traefik: 2.
# Default 0 ignores X-Forwarded-For (request.ip = TCP peer only).
# ASTRO_TRUST_PROXY_HOPS=1
# ASTRO_RATE_LIMIT_DISABLED=1
# ASTRO_RATE_LIMIT_WINDOW_MS=60000
# ASTRO_RATE_LIMIT_IP_MAX=300
# ASTRO_RATE_LIMIT_MAX=120
# ASTRO_RATE_LIMIT_EXPENSIVE_MAX=40
# ASTRO_RATE_LIMIT_JOB_MAX=180

# MapLibre style JSON URLs (public — any key in the URL is visible to clients).
# Must be https. Leave unset/empty for the in-app country-outline preview.
# See docs/MAP_SETUP.md. Placeholder: https://demotiles.maplibre.org/style.json
# ASTRO_MAP_STYLE_LIGHT=
# ASTRO_MAP_STYLE_DARK=

# Reading models (defaults are free-tier Flash; set a Pro id only with billing).
ASTRO_LLM_MODEL=gemini-3.5-flash-lite
ASTRO_CHEAP_MODEL=gemini-3.5-flash-lite
# ASTRO_ASK_MODEL=   # defaults to ASTRO_LLM_MODEL / gemini-3.5-flash-lite when Ask is enabled
GEMINI_THINKING_LEVEL=minimal

# Host API against docker-compose.dev.yml Postgres (ignored by the API container;
# production compose builds DATABASE_URL from POSTGRES_* above).
# DATABASE_URL=postgres://astrology:astrology@127.0.0.1:5432/astrology

# Demo login (any email + 000000). Must stay off in production (NODE_ENV=production).
ASTRO_DEMO_AUTH=0
AUTH_ENABLED=1

# Multi-user Supabase (omit AUTH_OWNER_EMAIL so every confirmed user is a tenant):
# AUTH_ENABLED=1
# SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...   # backend only — never in the app
# SUPABASE_JWKS_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json
# AUTH_OWNER_EMAIL=

# Optional LLM keys (Gemini free key is enough with the Flash defaults above)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Backend Sentry (secret). Leave empty/unset to disable reporting; never commit a real DSN.
SENTRY_DSN=

# Leave UNSET in every environment (paid guard / config:check refuse):
# OPENAI_BASE_URL=
# GOOGLE_GENAI_USE_VERTEXAI=

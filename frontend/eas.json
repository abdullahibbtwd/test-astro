{
  "cli": {
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.14.0",
      "channel": "development",
      "android": {
        "image": "sdk-57",
        "ndk": "27.1.12297006",
        "buildType": "apk",
        "withoutCredentials": true
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.14.0",
      "channel": "preview",
      "android": {
        "image": "sdk-57",
        "ndk": "27.1.12297006",
        "buildType": "apk"
      }
    },
    "production": {
      "node": "22.14.0",
      "channel": "production",
      "autoIncrement": "versionCode",
      "android": {
        "image": "sdk-57",
        "ndk": "27.1.12297006",
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

{
  "name": "astrology-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "contract:build": "tsx scripts/build-contract.ts",
    "contract:types": "openapi-typescript openapi.yaml -o src/api/schema.d.ts",
    "contract:zod": "tsx scripts/build-zod.ts",
    "fixtures:build": "tsx scripts/build-map-geometry.ts && tsx scripts/build-countries.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run contract:build && npm run contract:types && npm run contract:zod && npm run fixtures:build && npm run typecheck && npm run lint && npm test && npm run test:native",
    "lint": "eslint app src scripts packages tests",
    "bundle": "expo export --platform ios --platform android --output-dir artifacts/bundle",
    "test:native": "jest --runInBand",
    "release:check": "tsx scripts/release-check.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@expo-google-fonts/inter": "0.4.2",

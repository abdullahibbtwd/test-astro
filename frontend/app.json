{
  "expo": {
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "enableSceneSupport": true,
            "newArchEnabled": true,
            "forceStaticLinking": [
              "NitroModules",
              "NitroMmkv"
            ]
          },
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "ndkVersion": "27.1.12297006",
            "kotlinVersion": "2.1.20",
            "newArchEnabled": true
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-background-task",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow Astrology to save the chart images you choose to your photos.",
          "granularPermissions": []
        }
      ],
      "./plugins/withAndroidReleaseHardening.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b748e2a7-4809-42b3-92f3-a832813d9d3a"
      }
    },
    "owner": "abddullahibbtwd"
  }
}

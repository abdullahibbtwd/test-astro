{
  "expo": {
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "enableSceneSupport": true,
            "newArchEnabled": true,
            "forceStaticLinking": [
              "NitroModules",
              "NitroMmkv"
            ]
          },
          "android": {
            "minSdkVersion": 26,
            "newArchEnabled": true
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-background-task",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow Astrology to save the chart images you choose to your photos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

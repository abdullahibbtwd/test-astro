# Public mobile configuration only. No provider secrets here.
# For EAS builds, set the same keys as EAS Environment Variables (not in eas.json).
# See docs/ANDROID_BUILD.md for the full required-variable list with examples.

# --- Required for non-dev / EAS preview+production ---
EXPO_PUBLIC_API_URL=https://api.example.com/v1
EXPO_PUBLIC_AUTH_MODE=supabase

# --- Required for real Supabase auth ---
# Publishable only — never put SUPABASE_SECRET_KEY in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Optional / feature ---
EXPO_PUBLIC_BACKEND_MODE=local
# Show demo email+000000 hint in __DEV__ only when explicitly enabled:
# EXPO_PUBLIC_DEMO_LOGIN_HINT=1
# EXPO_PUBLIC_SHARE_URL=https://YOUR_APP_DOMAIN/
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-yyyy.apps.googleusercontent.com
# GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.1234567890-yyyy
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# EXPO_PUBLIC_EAS_BUILD_PROFILE=production

# Local Node API reads its own process environment, not this file automatically.
# EXPO_PUBLIC_API_URL=http://127.0.0.1:4020/v1

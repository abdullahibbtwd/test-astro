# Public mobile configuration only. No provider secrets here.
# The Node local API reads its process environment, not this file automatically.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4010/v1
EXPO_PUBLIC_BACKEND_MODE=demo
EXPO_PUBLIC_AUTH_MODE=demo

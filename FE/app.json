{
  "expo": {
    "name": "Astrology",
    "slug": "astrology-mobile",
    "version": "0.1.0",
    "scheme": "astrology-dev",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": { "bundleIdentifier": "com.example.astrology.dev", "supportsTablet": true },
    "android": { "package": "com.example.astrology.dev" },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "@maplibre/maplibre-react-native",
      ["expo-build-properties", {"ios":{"deploymentTarget":"16.4","enableSceneSupport":true},"android":{"minSdkVersion":26}}]
    ],
    "experiments": { "typedRoutes": true }
  }
}

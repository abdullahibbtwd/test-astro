{
  "name": "astrology-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "mock": "tsx mock/server.ts",
    "local-api": "tsx api/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",

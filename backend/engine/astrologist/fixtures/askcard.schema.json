{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Hand-built from FE/FE_09_ASK_ASTROLOGY_SPEC.md §4.3 (AskCard) and FE/FE_02_API_CONTRACT_SPEC.md §3, §7.3, §7.4 until the FE repo generates openapi.yaml (PA Phase 0 G7). additionalProperties false, so a stray field fails.",
  "$defs": {
    "ISODate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "Body": {"enum": ["sun", "moon", "mercury", "venus", "mars", "jupiter", "saturn", "uranus", "neptune", "pluto", "north_node", "south_node"]},
    "Angle": {"enum": ["ASC", "DSC", "MC", "IC"]},
    "Sign": {"enum": ["aries", "taurus", "gemini", "cancer", "leo", "virgo", "libra", "scorpio", "sagittarius", "capricorn", "aquarius", "pisces"]},
    "AspectType": {"enum": ["conjunction", "sextile", "square", "trine", "opposition"]},
    "Goal": {"enum": ["love", "career", "business", "money", "family", "education", "creativity", "spirituality", "rest", "travel", "relocation"]},
    "PlaceBand": {"enum": ["strongly_supportive", "supportive", "mixed", "no_emphasis", "challenging"]},
    "Activity": {"enum": ["love", "meetings", "business", "contract", "conversation", "travel", "shopping", "project_start", "interview", "moving"]},
    "Grade": {"enum": ["excellent", "good", "neutral", "avoid"]},
    "Importance": {"enum": ["major", "moderate", "minor", "collective"]},
    "CompatType": {"enum": ["love", "family", "work"]},
    "TransitPhase": {"enum": ["building", "peak", "easing"]},
    "PeriodRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "goal", "goal_label", "kind", "label", "start", "end", "peak", "strength", "importance", "has_text"],
      "properties": {"id": {"type": "string"}, "goal": {"$ref": "#/$defs/Goal"}, "goal_label": {"type": "string"},
                     "kind": {"enum": ["favorable", "challenging"]}, "label": {"type": "string"},
                     "start": {"$ref": "#/$defs/ISODate"}, "end": {"$ref": "#/$defs/ISODate"}, "peak": {"$ref": "#/$defs/ISODate"},
                     "strength": {"enum": ["normal", "strong"]}, "importance": {"$ref": "#/$defs/Importance"},
                     "has_text": {"type": "boolean"}}
    },
    "TransitEpisode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "importance", "transiting", "aspect", "natal", "start", "end", "exact_dates", "phase", "phase_label", "has_text"],
      "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "importance": {"$ref": "#/$defs/Importance"},
                     "transiting": {"$ref": "#/$defs/Body"}, "aspect": {"$ref": "#/$defs/AspectType"},
                     "natal": {"anyOf": [{"$ref": "#/$defs/Body"}, {"$ref": "#/$defs/Angle"}]},
                     "start": {"$ref": "#/$defs/ISODate"}, "end": {"$ref": "#/$defs/ISODate"},
                     "exact_dates": {"type": "array", "items": {"$ref": "#/$defs/ISODate"}},
                     "phase": {"$ref": "#/$defs/TransitPhase"}, "phase_label": {"type": "string"}, "has_text": {"type": "boolean"}}
    }
  },
  "oneOf": [
    {"type": "object", "additionalProperties": false,
     "required": ["type", "body", "sign", "degree_in_sign", "house", "retrograde"],
     "properties": {"type": {"const": "chart_fact"}, "body": {"$ref": "#/$defs/Body"}, "sign": {"$ref": "#/$defs/Sign"},
                    "degree_in_sign": {"type": "number"}, "house": {"type": "integer", "minimum": 1, "maximum": 12},
                    "retrograde": {"type": "boolean"}}},
    {"type": "object", "additionalProperties": false, "required": ["type", "activity", "days"],
     "properties": {"type": {"const": "best_days"}, "activity": {"$ref": "#/$defs/Activity"},
                    "days": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["date", "grade"],
                                                         "properties": {"date": {"$ref": "#/$defs/ISODate"}, "grade": {"$ref": "#/$defs/Grade"}}}}}},
    {"type": "object", "additionalProperties": false, "required": ["type", "place_id", "name", "country_code", "cards"],
     "properties": {"type": {"const": "place"}, "place_id": {"type": "string"}, "name": {"type": "string"},
                    "country_code": {"type": "string"},
                    "cards": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                                          "required": ["goal", "band", "band_label"],
                                                          "properties": {"goal": {"$ref": "#/$defs/Goal"}, "band": {"$ref": "#/$defs/PlaceBand"},
                                                                         "band_label": {"type": "string"}}}}}},
    {"type": "object", "additionalProperties": false, "required": ["type", "period"],
     "properties": {"type": {"const": "period"}, "period": {"$ref": "#/$defs/PeriodRef"}}},
    {"type": "object", "additionalProperties": false, "required": ["type", "transit"],
     "properties": {"type": {"const": "transit"}, "transit": {"$ref": "#/$defs/TransitEpisode"}}},
    {"type": "object", "additionalProperties": false, "required": ["type", "compatibility_id", "labels", "compat_type"],
     "properties": {"type": {"const": "compatibility"}, "compatibility_id": {"type": "string"},
                    "labels": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
                    "compat_type": {"$ref": "#/$defs/CompatType"}}},
    {"type": "object", "additionalProperties": false, "required": ["type", "horizon", "title"],
     "properties": {"type": {"const": "forecast"}, "horizon": {"enum": ["day", "month", "year"]},
                    "date": {"$ref": "#/$defs/ISODate"}, "month": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"},
                    "title": {"type": "string"}}}
  ]
}
